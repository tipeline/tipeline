{
  "name": "@tipeline/utils",
  "version": "0.0.0",
  "description": "Tipeline utils",
  "license": "Apache-2.0",
  "author": "José Daniel Estrada Guzmán",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./coreProcess": {
      "types": "./dist/coreProcess.d.ts",
      "default": "./dist/coreProcess.js"
    },
    "./coreService": {
      "types": "./dist/coreService.d.ts",
      "default": "./dist/coreService.js"
    }
  },
  "typesVersions": {
    "*": {
      "coreProcess": [
        "dist/coreProcess.d.ts"
      ],
      "coreService": [
        "dist/coreService.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js",
    "test": "vitest run",
    "prepack": "rm -rf dist && npm run build"
  },
  "keywords": [
    "schemas",
    "zod",
    "tipeline"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "dependencies": {
    "@tipeline/types": "0.0.0",
    "chrono-node": "^2.10.3",
    "cron-parser": "^4.9.0",
    "cronstrue": "^3.38.0",
    "marked": "^18.1.0",
    "nanoid": "^5.1.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.13",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tipeline/tipeline.git",
    "directory": "packages/utils"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
