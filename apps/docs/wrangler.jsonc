{
  // A static site on Cloudflare Workers: no server code runs.
  "name": "tipeline",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    // /actions, not /actions/: matches the URLs the site will have on Drupal.
    "html_handling": "drop-trailing-slash"
  }
}
