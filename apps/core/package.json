{
  "name": "@tipeline/core",
  "version": "0.0.0",
  "description": "Tipeline Core",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "dev": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths --resolve-full-extension .js && rm -rf dist/database/migrations && mkdir -p dist/database/migrations && cp src/database/migrations/*.js dist/database/migrations/",
    "server": "npm run build && node dist/engine/Server.js",
    "worker": "node dist/engine/worker/WorkerServer.js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "generate:examples": "tsx scripts/extractActionExamples.ts",
    "prepack": "rm -rf dist && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tipeline/tipeline.git",
    "directory": "apps/core"
  },
  "author": "José Daniel Estrada Guzmán",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tipeline/tipeline/issues"
  },
  "homepage": "https://github.com/tipeline/tipeline#readme",
