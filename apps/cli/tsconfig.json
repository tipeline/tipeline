{
  "compilerOptions": {
    "target": "es2020",
    "module": "ES2020",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["es2021", "dom"]
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
